DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
AUTH_SECRET="generate-a-long-random-string-here"
NEXT_PUBLIC_APP_NAME="Certo Drive"
# Optional: protects the reminder cron endpoint. If set, a scheduler can call
# GET /api/cron/reminders?secret=$CRON_SECRET. Admins can also run it from the dashboard.
CRON_SECRET=""

# Flight tracking (optional). AviationStack by default; leave unset to disable.
FLIGHT_API_KEY=
# FLIGHT_API_BASE=https://api.aviationstack.com/v1
